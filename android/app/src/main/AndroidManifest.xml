<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Para hablar con Google Vision y con la placa. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- networkSecurityConfig: permite http:// sin cifrar hacia el Arduino.
         El porque esta explicado dentro de res/xml/network_security_config.xml -->
    <application
        android:allowBackup="false"
        android:label="@string/nombre_app"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
